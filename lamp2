const editor=document.getElementById('editor'),tabsEl=document.getElementById('tabs'),
      filesEl=document.getElementById('files'),minimap=document.getElementById('minimap'),
      tbTitle=document.getElementById('tbTitle'),bcFile=document.getElementById('bcFile'),
      toasts=document.getElementById('toasts'),term=document.getElementById('term'),
      panel=document.getElementById('panel'),sidebar=document.getElementById('sidebar'),
      palette=document.getElementById('palette'),palInput=document.getElementById('palInput'),
      palList=document.getElementById('palList'),sbPos=document.getElementById('sbPos'),
      btnCopy=document.getElementById('btnCopy');

let openTabs=['p1.php'],active='p1.php',actLine=1;

function toast(msg){
  const t=document.createElement('div');t.className='toast';t.textContent=msg;
  toasts.appendChild(t);
  setTimeout(()=>{t.style.transition='opacity .3s';t.style.opacity='0';setTimeout(()=>t.remove(),320)},1800);
}
const esc=s=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
const TOK=/(\/\/[^\n]*|#[^\n]*)|('(?:\\.|[^'\\])*'|"(?:\\.|[^"\\])*")|(<\?php|<\?=|\?>)|(\$[A-Za-z_]\w*)|\b(if|else|elseif|foreach|for|while|switch|case|break|return|function|echo|array|isset|and|or|new|class)\b|\b(\d+(?:\.\d+)?)\b|(<\/?[a-zA-Z][\w-]*)/g;

function hl(line){
  let out='',last=0,m;TOK.lastIndex=0;
  while((m=TOK.exec(line))!==null){
    out+=esc(line.slice(last,m.index));
    const c=m[1]?'tk-com':m[2]?'tk-str':m[3]?'tk-php':m[4]?'tk-var':m[5]?'tk-kw':m[6]?'tk-num':'tk-tag';
    out+='<span class="'+c+'">'+esc(m[0])+'</span>';
    last=m.index+m[0].length;
  }
  return out+esc(line.slice(last));
}
function mmColor(l){
  const t=l.trim();if(!t)return null;
  if(t.startsWith('//')||t.startsWith('#'))return '#6a9955';
  if(t.includes('<?php')||t.includes('?>'))return '#c586c0';
  if(t.startsWith('$'))return '#9cdcfe';
  if(t.startsWith('echo'))return '#ce9178';
  if(t.startsWith('<'))return '#569cd6';
  return '#9d9d9d';
}

function renderFiles(){
  filesEl.innerHTML='';
  FILES.forEach(f=>{
    const d=document.createElement('div');
    d.className='file'+(f.name===active?' active':'');
    const ext=f.name.split('.').pop();
    d.innerHTML='<span class="fi '+ext+'">'+ext.toUpperCase()+'</span>'+f.name;
    d.onclick=()=>openFile(f.name);
    filesEl.appendChild(d);
  });
  const scm=document.getElementById('scmFiles');
  scm.innerHTML='';
  FILES.filter(f=>f.kind==='php').forEach(f=>{
    const d=document.createElement('div');d.className='file';
    d.innerHTML='<span class="fi php">PHP</span>'+f.name;
    d.onclick=()=>openFile(f.name);scm.appendChild(d);
  });
}

function renderTabs(){
  tabsEl.innerHTML='';
  openTabs.forEach(n=>{
    const t=document.createElement('div');
    t.className='tab'+(n===active?' active':'');
    t.innerHTML='<span class="fi php">PHP</span>'+n+'<span class="x">✕</span>';
    t.onclick=e=>{
      if(e.target.classList.contains('x')){
        openTabs=openTabs.filter(x=>x!==n);
        if(active===n)active=openTabs[openTabs.length-1]||'p1.php';
        if(!openTabs.length){openTabs=['p1.php'];active='p1.php'}
        renderTabs();loadFile();return;
      }
      openFile(n);
    };
    tabsEl.appendChild(t);
  });
}

function loadFile(){
  const f=FILES.find(x=>x.name===active)||FILES[0];
  tbTitle.textContent=f.name+' - php-lab - Visual Studio Code';
  bcFile.textContent=f.name;
  document.title=f.name+' - php-lab - Visual Studio Code';
  const lines=f.code.split('\n');
  editor.innerHTML='';
  lines.forEach((ln,i)=>{
    const row=document.createElement('div');
    row.className='row'+(i+1===actLine?' act':'');
    row.innerHTML='<div class="ln">'+(i+1)+'</div><div class="lc">'+(i+1===actLine?'<span class="caret"></span>':'')+hl(ln)+'</div>';
    row.onclick=()=>{actLine=i+1;sbPos.textContent='Ln '+(i+1)+', Col 1';
      editor.querySelectorAll('.row').forEach((r,k)=>r.classList.toggle('act',k===i+1));
      loadFileKeepScroll();};
    editor.appendChild(row);
  });
  minimap.innerHTML='<div class="mmView"></div>';
  lines.slice(0,160).forEach(ln=>{
    const c=mmColor(ln);if(!c)return;
    const b=document.createElement('div');b.className='mm';
    b.style.background=c;b.style.width=Math.min(100,Math.max(6,ln.length*1.4))+'%';
    minimap.appendChild(b);
  });
  term.innerHTML='<div class="dim">PS C:\\xampp\\htdocs\\php-lab&gt; <span class="g">php '+f.name+'</span></div>'+
    '<div class="dim">'+(f.kind==='php'?'[OK] executed without fatal errors':'static file — open in browser')+'</div>'+
    '<div class="dim">PS C:\\xampp\\htdocs\\php-lab&gt; <span class="caret" style="height:13px"></span></div>';
  renderFiles();renderTabs();
}
function loadFileKeepScroll(){const s=editor.scrollTop;loadFile();editor.scrollTop=s}
function openFile(name){active=name;actLine=1;if(!openTabs.includes(name))openTabs.push(name);loadFile();editor.scrollTop=0}

async function copyText(t){
  try{await navigator.clipboard.writeText(t);return true}catch(e){
    const ta=document.createElement('textarea');ta.value=t;ta.style.position='absolute';
    ta.style.left='-9999px';document.body.appendChild(ta);ta.select();
    let ok=false;try{ok=document.execCommand('copy')}catch(_){}
    ta.remove();return ok;}
}
async function copyCurrent(){
  const f=FILES.find(x=>x.name===active);if(!f)return;
  const ok=await copyText(f.code);
  toast(ok?'Copied '+f.name+' to clipboard':'Copy failed');
  if(ok){btnCopy.classList.add('ok');setTimeout(()=>btnCopy.classList.remove('ok'),1000)}
}
async function copyAll(){
  const all=FILES.filter(f=>f.kind==='php').map(f=>'// ===== '+f.name+' =====\n'+f.code).join('\n\n\n');
  const ok=await copyText(all);toast(ok?'Copied all 5 programs':'Copy failed');
}
btnCopy.onclick=copyCurrent;
document.getElementById('btnCopyAll').onclick=copyAll;

const VIEWS={explorer:'viewExplorer',search:'viewSearch',scm:'viewSCM',debug:'viewDebug',ext:'viewExt'};
function showView(v){
  Object.entries(VIEWS).forEach(([k,id])=>document.getElementById(id).hidden=(k!==v));
  document.querySelectorAll('.act').forEach(a=>a.classList.toggle('active',a.dataset.v===v));
  sidebar.classList.remove('hidden');
  if(v==='search')document.getElementById('sInput').focus();
}
document.querySelectorAll('.act[data-v]').forEach(a=>a.onclick=()=>{
  if(a.classList.contains('active')&&!sidebar.classList.contains('hidden'))sidebar.classList.add('hidden');
  else showView(a.dataset.v);
});

const sInput=document.getElementById('sInput'),sResults=document.getElementById('sResults');
sInput.addEventListener('input',()=>{
  const q=sInput.value.trim();
  sResults.innerHTML='';
  if(!q){sResults.innerHTML='<div class="sEmpty">Search across all files</div>';return}
  let n=0;
  FILES.forEach(f=>{
    const hits=f.code.split('\n').map((l,i)=>[l,i+1]).filter(([l])=>l.toLowerCase().includes(q.toLowerCase()));
    if(!hits.length)return;
    const h=document.createElement('div');h.className='sFile';
    h.innerHTML='<span class="fi php">PHP</span>'+f.name+' <span style="color:#8b8b8b;font-weight:400">'+hits.length+'</span>';
    sResults.appendChild(h);
    hits.slice(0,6).forEach(([l,i])=>{
      const d=document.createElement('div');d.className='sHit';
      const idx=l.toLowerCase().indexOf(q.toLowerCase());
      d.innerHTML=esc(l.slice(Math.max(0,idx-14),idx))+'<b>'+esc(l.substr(idx,q.length))+'</b>'+esc(l.substr(idx+q.length,26));
      d.onclick=()=>openFile(f.name);sResults.appendChild(d);
    });
    n+=hits.length;
  });
  if(!n)sResults.innerHTML='<div class="sEmpty">No results found.</div>';
});

const COMMANDS=[{n:'Copy current file'},{n:'Copy all programs'},{n:'Toggle terminal'},{n:'Toggle sidebar'},{n:'Go to file'}];
function openPalette(pre){palette.hidden=false;palInput.value=pre||'';renderPal();palInput.focus()}
function renderPal(){
  palList.innerHTML='';
  const q=palInput.value.replace(/^>/,'').trim().toLowerCase();
  if(palInput.value.startsWith('>')){
    COMMANDS.filter(c=>c.n.toLowerCase().includes(q)).forEach((c,i)=>{
      const d=document.createElement('div');d.className='palItem'+(i===0?' sel':'');
      d.textContent=c.n;d.onclick=()=>{runCommand(c.n);palette.hidden=true};
      palList.appendChild(d);
    });
  } else {
    FILES.filter(f=>f.name.toLowerCase().includes(q)).forEach((f,i)=>{
      const d=document.createElement('div');d.className='palItem'+(i===0?' sel':'');
      d.innerHTML='<span class="fi '+f.name.split('.').pop()+'">'+f.name.split('.').pop().toUpperCase()+'</span>'+f.name;
      d.onclick=()=>{openFile(f.name);palette.hidden=true};
      palList.appendChild(d);
    });
  }
}
function runCommand(n){
  if(n==='Copy current file')copyCurrent();
  if(n==='Copy all programs')copyAll();
  if(n==='Toggle terminal')panel.classList.toggle('hidden');
  if(n==='Toggle sidebar')sidebar.classList.toggle('hidden');
  if(n==='Go to file')openPalette('');
}
palInput.addEventListener('input',renderPal);
palInput.addEventListener('keydown',e=>{
  const items=[...palList.children],cur=items.findIndex(i=>i.classList.contains('sel'));
  if(e.key==='ArrowDown'){e.preventDefault();items[cur]?.classList.remove('sel');items[Math.min(items.length-1,cur+1)]?.classList.add('sel')}
  if(e.key==='ArrowUp'){e.preventDefault();items[cur]?.classList.remove('sel');items[Math.max(0,cur-1)]?.classList.add('sel')}
  if(e.key==='Enter'){e.preventDefault();items[cur]?.click()}
  if(e.key==='Escape')palette.hidden=true;
});
document.addEventListener('click',e=>{
  if(!palette.hidden&&!palette.contains(e.target))palette.hidden=true;
});

document.addEventListener('keydown',e=>{
  const c=e.ctrlKey||e.metaKey,inPal=document.activeElement===palInput;
  if(c&&e.shiftKey&&e.key.toLowerCase()==='p'){e.preventDefault();openPalette('>');return}
  if(c&&e.key.toLowerCase()==='p'){e.preventDefault();openPalette('');return}
  if(c&&e.shiftKey&&e.key.toLowerCase()==='c'){e.preventDefault();copyAll();return}
  if(c&&e.key.toLowerCase()==='c'&&!window.getSelection().toString()){e.preventDefault();copyCurrent();return}
  if(c&&e.key==='`'){e.preventDefault();panel.classList.toggle('hidden');return}
  if(c&&e.key.toLowerCase()==='b'){e.preventDefault();sidebar.classList.toggle('hidden');return}
  if(c&&e.shiftKey&&e.key.toLowerCase()==='e'){e.preventDefault();showView('explorer');return}
  if(c&&e.shiftKey&&e.key.toLowerCase()==='f'){e.preventDefault();showView('search');return}
  if(e.key==='Escape'){palette.hidden=true;return}
  if(inPal||document.activeElement===sInput)return;
  if(!c){
    const n=parseInt(e.key,10);
    if(n>=1&&n<=5){e.preventDefault();openFile('p'+n+'.php');copyCurrent()}
  }
});

loadFile();
</script>
</body>
